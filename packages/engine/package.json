{
  "name": "@galvanigraph/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "typecheck:scripts": "tsc -p tsconfig.sandbox.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@galvanigraph/core-models": "workspace:*",
    "@galvanigraph/core-util": "workspace:*",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.12.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.1",
    "rimraf": "6.1.4",
    "tsx": "4.23.15",
    "vitest": "5.1.1"
  }
}
