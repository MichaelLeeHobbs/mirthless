{
  "name": "@galvaniflow/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist",
    "db:generate": "pnpm run build && drizzle-kit generate",
    "db:migrate": "pnpm run build && drizzle-kit migrate",
    "db:studio": "pnpm run build && drizzle-kit studio",
    "db:check": "pnpm run build && drizzle-kit check",
    "db:seed": "tsx src/db/seeds/run-seed.ts"
  },
  "dependencies": {
    "@galvaniflow/connectors": "workspace:^",
    "@galvaniflow/core-models": "workspace:*",
    "@galvaniflow/core-util": "workspace:*",
    "@galvaniflow/engine": "workspace:^",
    "@prometheus-io/client": "^0.16.1",
    "bcryptjs": "3.0.3",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "esbuild": "^0.28.2",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "fast-xml-parser": "^5.11.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "^10.2.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "socket.io": "4.8.4",
    "stderr-lib": "2.2.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "rimraf": "6.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
