# A pattern without **/ matches only at the root. The Dockerfiles copy whole
# package folders (COPY packages/<name>/), so anything a checkout leaves inside
# a package needs **/ to stay out of the image (#137).

# Dependencies (every package's, not only the root's: a host install would
# overwrite the container's own pnpm links when packages/<name>/ is copied)
**/node_modules/

# Git
.git/
.gitignore

# Claude
.claude/

# Reference source (large, not needed in builds)
reference/

# Test & coverage artifacts
**/coverage/
**/*.test.ts
**/*.spec.ts

# Documentation
docs/

# GitHub
.github/

# Environment files (secrets). The server also reads packages/server/.env.
**/.env
**/.env.*
!.env.example

# Editor & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Build artifacts (rebuilt in Docker)
**/dist/

# E2E tests
e2e/
playwright.config.ts
playwright-report/
test-results/

# Test-only sources (helpers under __tests__ are not *.test.ts and would otherwise be compiled)
**/__tests__/
