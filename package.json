{
  "name": "galvanigraph",
  "private": true,
  "type": "module",
  "scripts": {
    "------------ Development ------------": "",
    "dev": "pnpm run --parallel dev",
    "dev:server": "pnpm --filter @galvanigraph/server dev",
    "dev:web": "pnpm --filter @galvanigraph/web dev",

    "------------ Build & Quality ------------": "",
    "build": "pnpm run -r build",
    "lint": "eslint packages e2e --max-warnings 0 && pnpm typecheck:tests",
    "lint:fix": "eslint packages e2e --max-warnings 0 --fix",
    "typecheck:tests": "pnpm -r run typecheck:tests && tsc -p e2e/tsconfig.json && tsc -p e2e/scenarios/tsconfig.json",
    "gate": "pnpm build && pnpm lint && pnpm test:coverage && pnpm test:ci",
    "clean": "pnpm run -r clean",

    "------------ Testing ------------": "",
    "test": "pnpm run -r test",
    "test:coverage": "pnpm run -r test:coverage",
    "test:ci": "node --test scripts/ci/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "shots": "node scripts/shots/shots.mjs",
    "test:scenarios": "node scripts/scenarios/run.mjs",
    "test:integration": "pnpm --filter @galvanigraph/server exec vitest run --config vitest.integration.config.ts",

    "------------ Database ------------": "",
    "db:init": "node scripts/init-db.mjs",
    "db:migrate": "pnpm --filter @galvanigraph/server db:migrate",
    "db:seed": "pnpm --filter @galvanigraph/server db:seed",
    "db:generate": "pnpm --filter @galvanigraph/server db:generate",
    "db:check": "pnpm --filter @galvanigraph/server db:check",
    "db:studio": "pnpm --filter @galvanigraph/server db:studio",

    "------------ Infrastructure (Docker) ------------": "",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:reset": "docker compose -f docker/docker-compose.yml down -v && docker compose -f docker/docker-compose.yml up -d",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",

    "------------ Performance ------------": "",
    "db:bench": "node scripts/bench-db.mjs",
    "bench:throughput": "node scripts/bench-throughput.mjs",
    "soak": "node scripts/soak.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "imapflow": "^2.11.0",
    "mysql2": "3.24.6",
    "nodemailer": "^10.5.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "ssh2-sftp-client": "^12.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
