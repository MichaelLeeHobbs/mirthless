{
  "name": "mirthless",
  "private": true,
  "type": "module",
  "scripts": {
    "------------ Development ------------": "",
    "dev": "pnpm run --parallel dev",
    "dev:server": "pnpm --filter @mirthless/server dev",
    "dev:web": "pnpm --filter @mirthless/web dev",

    "------------ Build & Quality ------------": "",
    "build": "pnpm run -r build",
    "lint": "eslint packages --max-warnings 0",
    "lint:fix": "eslint packages --max-warnings 0 --fix",
    "clean": "pnpm run -r clean",

    "------------ Testing ------------": "",
    "test": "pnpm run -r test",
    "test:coverage": "pnpm run -r test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:integration": "pnpm --filter @mirthless/server exec vitest run --config vitest.integration.config.ts",

    "------------ Database ------------": "",
    "db:init": "node scripts/init-db.mjs",
    "db:migrate": "pnpm --filter @mirthless/server db:migrate",
    "db:seed": "pnpm --filter @mirthless/server db:seed",
    "db:generate": "pnpm --filter @mirthless/server db:generate",
    "db:check": "pnpm --filter @mirthless/server db:check",
    "db:studio": "pnpm --filter @mirthless/server db:studio",

    "------------ Infrastructure (Docker) ------------": "",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:reset": "docker compose -f docker/docker-compose.yml down -v && docker compose -f docker/docker-compose.yml up -d",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",

    "------------ Performance ------------": "",
    "db:bench": "node scripts/bench-db.mjs",
    "bench:throughput": "node scripts/bench-throughput.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "eslint": "9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.1",
  "pnpm": {
    "comment": "Security overrides — bounded to the current major so we only take the patch. adm-zip is pinned to 0.6.1 under dcmjs, which declares it but never imports it.",
    "overrides": {
      "express-rate-limit@8": ">=8.2.2 <9",
      "socket.io-parser@4": ">=4.2.7 <5",
      "fast-xml-parser@5": ">=5.10.1 <6",
      "path-to-regexp@<1": "0.1.13",
      "ws@8": ">=8.20.1 <9",
      "yaml@1": ">=1.10.3 <2",
      "dompurify@3": ">=3.3.2 <4",
      "qs@6": ">=6.14.2 <7",
      "proxy-addr@2": ">=2.0.8 <3",
      "engine.io@6": ">=6.6.10 <7",
      "compression@1": ">=1.8.2 <2",
      "ip-address@10": ">=10.3.1 <11",
      "adm-zip@0.5": "0.6.1",
      "react-router@6": ">=6.30.4 <7",
      "react-router-dom@6": ">=6.30.4 <7"
    }
  }
}
